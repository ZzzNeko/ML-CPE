# Optional: self-host MediaPipe runtime/model for production.
# Leave unset to use the CDN defaults defined in src/data/gameConfig.ts.
VITE_POSE_WASM_PATH=/assets/models/wasm
VITE_POSE_MODEL_PATH=/assets/models/pose_landmarker_lite.task

# Optional: shorten Pose Rhythm songs (seconds, minimum 20) while testing.
# Unset = the per-difficulty length in src/game/rhythm/poseBeatmap.ts (90 / 120 / 150 s).
# VITE_POSE_SONG_SECONDS=30

# Heart-rate band (ESP32). See api/heartrate.ts.
# Server-side (set in the Vercel dashboard, not VITE_): KV_REST_API_URL, KV_REST_API_TOKEN, DEVICE_API_KEY
# Optional client-side overrides:
# VITE_HEARTRATE_DEVICE=fitquest-band-01
# VITE_HEARTRATE_URL=/api/heartrate
